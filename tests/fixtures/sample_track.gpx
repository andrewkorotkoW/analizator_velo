<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="anal_velo tests"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:gpxtpx="http://www.garmin.com/xmlschemas/TrackPointExtension/v1">
  <trk>
    <name>Sample ride</name>
    <trkseg>
      <trkpt lat="45.0000000" lon="0.0000000">
        <ele>100</ele>
        <time>2026-08-01T10:00:00Z</time>
        <extensions>
          <gpxtpx:TrackPointExtension>
            <gpxtpx:hr>120</gpxtpx:hr>
          </gpxtpx:TrackPointExtension>
        </extensions>
      </trkpt>
      <trkpt lat="45.0009000" lon="0.0000000">
        <ele>102</ele>
        <time>2026-08-01T10:00:10Z</time>
        <extensions>
          <gpxtpx:TrackPointExtension>
            <gpxtpx:hr>125</gpxtpx:hr>
          </gpxtpx:TrackPointExtension>
        </extensions>
      </trkpt>
      <trkpt lat="45.0018000" lon="0.0000000">
        <ele>101</ele>
        <time>2026-08-01T10:00:20Z</time>
        <extensions>
          <gpxtpx:TrackPointExtension>
            <gpxtpx:hr>130</gpxtpx:hr>
          </gpxtpx:TrackPointExtension>
        </extensions>
      </trkpt>
      <!-- Пауза дольше 30с на месте: та же точка, большой разрыв по времени -->
      <trkpt lat="45.0018000" lon="0.0000000">
        <ele>104</ele>
        <time>2026-08-01T10:01:40Z</time>
        <extensions>
          <gpxtpx:TrackPointExtension>
            <gpxtpx:hr>128</gpxtpx:hr>
          </gpxtpx:TrackPointExtension>
        </extensions>
      </trkpt>
      <trkpt lat="45.0027000" lon="0.0000000">
        <ele>103</ele>
        <time>2026-08-01T10:01:50Z</time>
        <extensions>
          <gpxtpx:TrackPointExtension>
            <gpxtpx:hr>135</gpxtpx:hr>
          </gpxtpx:TrackPointExtension>
        </extensions>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
